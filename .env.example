# ============================================================
# StayConnect — Production Environment Configuration Template
# ============================================================
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:3000

# PostgreSQL + PostGIS Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=stayconnect_user
DATABASE_PASSWORD=stayconnect_secure_dev_pass
DATABASE_NAME=stayconnect_db
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public

# Redis (Session cache, BullMQ, Rate-limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_random
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Meilisearch Full-Text Search Engine
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key

# S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_PUBLIC_BUCKET=stayconnect-public-media
S3_PRIVATE_DOCUMENTS_BUCKET=stayconnect-private-kyc-docs

# SMS / WhatsApp OTP Gateway (India)
SMS_GATEWAY_PROVIDER=mock_for_dev # options: fast2sms, gupshup, msg91
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=STYCON

# Google Maps API (Geocoding & Autocomplete)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=stayconnect-dev
FCM_CLIENT_EMAIL=firebase-adminsdk@stayconnect-dev.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
